# =============================================================================
# TruCommerce Backoffice (Vite + React) — Environment Variables
# =============================================================================
# Copy to .env.local for local development, or set in docker-compose.yml.
# =============================================================================

# API base URL — used by the Vite dev server proxy.
# In Docker, use the backend service name.
# The browser uses relative paths (/api/...) which are proxied to this target.
VITE_API_BASE_URL=http://backend:8080
