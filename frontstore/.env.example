# =============================================================================
# TruCommerce Frontstore (Next.js) — Environment Variables
# =============================================================================
# Copy to .env.local for local development, or set in docker-compose.yml.
# =============================================================================

# Public API base URL — used by the browser (client-side fetches).
# In Docker, this should be the host-accessible backend URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:18080

# Internal API base URL — used by server-side rendering (RSC/SSR).
# In Docker, use the backend service name.
INTERNAL_API_BASE_URL=http://backend:8080

# Backoffice URL — used for cross-links in the storefront.
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:5173
