# =============================================================================
# TruCommerce Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# All variables have sensible defaults for development; production requires
# overriding secrets and security-related flags.
# =============================================================================

# ---- Application ----
# Environment: development | staging | production
APP_ENV=development
# Application name (used in logs and bootstrap)
APP_NAME=trucommerce
# Backend HTTP port (container-internal; host port is set in docker-compose)
PORT=8080

# ---- Logging ----
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Log format: text | json (json recommended for production)
LOG_FORMAT=text

# ---- PostgreSQL ----
POSTGRES_USER=trucommerce
POSTGRES_PASSWORD=trucommerce
POSTGRES_DB=trucommerce
# Full DSN overrides POSTGRES_USER/PASSWORD/DB if set
# POSTGRES_DSN=postgres://trucommerce:trucommerce@localhost:5432/trucommerce?sslmode=disable
# Connection pool tuning
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m

# ---- Redis ----
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT / Authentication ----
# IMPORTANT: set to a strong random string (>=32 chars) in production
JWT_SECRET=dev-secret-change-me-in-production-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Superadmin bootstrap (created on first run if no superadmin exists).
# Leave empty to use the interactive setup wizard at /setup (Backoffice) instead.
SEED_SUPERADMIN_EMAIL=admin@trucommerce.app
SEED_SUPERADMIN_PASSWORD=admin12345

# ---- CORS ----
# Comma-separated list of allowed origins
# Backoffice is served at /backoffice on the frontstore domain — no separate port needed
# Include tunnel domains if exposing via HTTPS tunnel (e.g. https://your-tunnel.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:13000,http://127.0.0.1:13000,http://0.0.0.0:13000,https://trucommerce.mohammedshahid.in
CORS_MAX_AGE=12h

# ---- HTTP Server ----
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
# Graceful shutdown wait before force-killing connections
SHUTDOWN_TIMEOUT=15s

# ---- Rate Limiting ----
# When enabled, applies per-IP request throttling
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BURST=20

# ---- Cookie / Session ----
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
# SameSite policy: strict | lax | none
COOKIE_SAME_SITE=lax
# Optional domain restriction for cookies (empty = current domain)
COOKIE_DOMAIN=

# ---- File Uploads ----
# Max upload size in bytes (default: 10 MB)
UPLOAD_MAX_SIZE=10485760
# Comma-separated MIME types allowed for upload
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif

# ---- SMTP / Email ----
# Leave empty to disable email sending (e.g. order confirmations, password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=TruCommerce

# ---- Payment Gateways ----
# Razorpay (leave empty to run in demo/mock mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Enable test payment endpoints (must be false in production)
ENABLE_TEST_PAYMENTS=true

# ---- Currency Cache ----
# How long exchange rates are cached in-memory
CURRENCY_CACHE_TTL=5m

# ---- Frontend (Next.js Frontstore) ----
# Public API URL (browser-facing, host port)
NEXT_PUBLIC_API_BASE_URL=http://localhost:13000
# Internal API URL (server-side SSR, docker service name)
INTERNAL_API_BASE_URL=http://backend:8080
# Internal backoffice URL (Vite dev server, proxied via Next.js rewrites at /backoffice)
INTERNAL_BACKOFFICE_URL=http://backoffice:5173

# ---- Frontend (Vite Backoffice) ----
# API URL for backoffice (server-side proxy target in dev)
VITE_API_BASE_URL=http://backend:8080

# ---- MCP Server (AI Integration) ----
# Backend API URL for the MCP server to call
MCP_API_BASE_URL=http://localhost:18080
# Default tenant slug for tenant-scoped MCP tools
MCP_DEFAULT_TENANT=demo
# Transport: "stdio" (local AI clients) or "sse" (HTTP+SSE for remote clients)
MCP_TRANSPORT=sse
# Listen address for SSE transport
MCP_ADDR=:9100
# Host port mapping for MCP SSE server
MCP_HOST_PORT=9100
# Optional auto-login credentials (leave empty to require per-session login via tools)
MCP_AUTH_EMAIL=
MCP_AUTH_PASSWORD=
# Tenant slug for auto-login (empty = superadmin login)
MCP_AUTH_TENANT=
